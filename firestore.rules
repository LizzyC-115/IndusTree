rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is a mod
    function isMod() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'mod';
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Allow unauthenticated reads so the login flow can look up a username→email
      // before the user has a Firebase Auth session.
      allow read: if true;
      // Owner can write their own profile; mods can update any user (for banning)
      allow write: if request.auth != null && request.auth.uid == userId;
      allow update: if isMod();
    }

    // ── Posts ─────────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Author can update/delete their own post; mods can update/delete any post
      allow update, delete: if request.auth != null &&
                            (request.auth.uid == resource.data.authorId || isMod());

      // ── Comments (subcollection) ─────────────────────────────────────────
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        // Author or mod can delete a comment
        allow delete: if request.auth != null &&
                      (request.auth.uid == resource.data.authorUid || isMod());
        allow update: if false;
      }
    }

    // ── Community rules (mod-editable) ────────────────────────────────────────
    match /communityRules/{industry} {
      allow read: if request.auth != null;
      allow write: if isMod();
    }

    // ── Votes ─────────────────────────────────────────────────────────────────
    match /votes/{voteId} {
      allow read, write: if request.auth != null;
    }

    // ── Saved posts ───────────────────────────────────────────────────────────
    match /saves/{saveId} {
      allow read, write: if request.auth != null;
    }

    // ── DM threads ────────────────────────────────────────────────────────────
    match /dmThreads/{threadId} {
      allow read, write: if request.auth != null
                         && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null;
    }
  }
}
